rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strictly isolate each user's data under /users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // All subcollections (entries, tasks, profile, chat, etc.) are private to the user
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

